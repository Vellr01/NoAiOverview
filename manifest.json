{
    "manifest_version": 3,
    "name": "NoAiOverview",
    "version": "1.0",
    "description": "Removes the Gemini Ai Overview that shows uppon a Google search.",
    "icons": {
        "48": "icons/noAiOverview-48.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "NoAiOverview@vellr01",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.google.com/*"
            ],
            "js": [
                "scripts/noAiOverview.js"
            ]
        }
    ],
    "action": {
        "default_popup": "scripts/popup/popup.html"
    },
    "permissions": [
        "storage"
    ]
}